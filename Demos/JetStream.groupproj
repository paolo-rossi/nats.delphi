        </BorlandProject>
    </ProjectExtensions>
    <Target Name="JetStreamBench">
        <MSBuild Projects="JetStream\JetStreamBench.dproj"/>
    </Target>
    <Target Name="JetStreamBench:Clean">
        <MSBuild Projects="JetStream\JetStreamBench.dproj" Targets="Clean"/>
    </Target>
    <Target Name="JetStreamBench:Make">
        <MSBuild Projects="JetStream\JetStreamBench.dproj" Targets="Make"/>
    </Target>
    <Target Name="JetStreamDemo">
        <MSBuild Projects="JetStream\JetStreamDemo.dproj"/>
    </Target>
    <Target Name="JetStreamDemo:Clean">
        <MSBuild Projects="JetStream\JetStreamDemo.dproj" Targets="Clean"/>
    </Target>
    <Target Name="JetStreamDemo:Make">
        <MSBuild Projects="JetStream\JetStreamDemo.dproj" Targets="Make"/>
    </Target>
    <Target Name="JetStreamJson">
        <MSBuild Projects="JetStream\JetStreamJson.dproj"/>
    </Target>
    <Target Name="JetStreamJson:Clean">
        <MSBuild Projects="JetStream\JetStreamJson.dproj" Targets="Clean"/>
    </Target>
    <Target Name="JetStreamJson:Make">
        <MSBuild Projects="JetStream\JetStreamJson.dproj" Targets="Make"/>
    </Target>
    <Target Name="JetStreamSessions">
        <MSBuild Projects="JetStream\JetStreamSessions.dproj"/>
    </Target>
    <Target Name="JetStreamSessions:Clean">
        <MSBuild Projects="JetStream\JetStreamSessions.dproj" Targets="Clean"/>
